{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TA Engine",
  "version": "0.9.0",
  "identifier": "io.github.taengine.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/game.html",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Total Annihilation",
        "url": "game.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.strategy-games",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
